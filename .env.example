# Copy to .env and fill in the values.

# Required: OpenAI key used for embeddings, routing and answers.
OPENAI_API_KEY=sk-your-key-here

# Required: PostgreSQL connection string. A managed instance is fine.
POSTGRES_URI=postgresql://user:password@localhost:5432/llmops_rag

# Optional: LangSmith tracing. Leave TRACING false if you do not use it.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llmops_rag

# Optional: host port for the container (default 8100).
BACKEND_PORT=8100
